{
  "expo": {
    "name": "Lavender",
    "slug": "lavender-app",
    "version": "0.1.0",
    "scheme": "lavender",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#62528d"
    },
    "android": {
      "package": "com.lavender.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#62528d"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-updates",
        {
          "username": "farrelputras"
        }
      ],
      "expo-font"
    ],
    "updates": {
      "url": "https://u.expo.dev/8bce9c4d-8ab5-4221-a061-d8c971ed8837",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "8bce9c4d-8ab5-4221-a061-d8c971ed8837"
      },
      "router": {}
    },
    "owner": "farrelputras"
  }
}
