{
  "expo": {
    "name": "Lavender",
    "slug": "lavender-app",
    "version": "0.1.0",
    "scheme": "lavender",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#8B7AB8"
    },
    "android": {
      "package": "com.lavender.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#8B7AB8"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-updates",
        {
          "username": "YOUR_EXPO_USERNAME"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/YOUR_PROJECT_ID",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
